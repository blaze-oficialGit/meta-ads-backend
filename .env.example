# Servidor
PORT=3000
NODE_ENV=production

# Frontend URL (para CORS) - URL do Vercel
FRONTEND_URL=https://meta-ads-frontend-one.vercel.app

# Meta/Facebook API
META_API_VERSION=v21.0
META_APP_ID=seu_app_id_aqui
META_APP_SECRET=seu_app_secret_aqui
META_REDIRECT_URI=https://meta-ads-backend-production.up.railway.app/api/auth/callback

# OpenAI (opcional - para interpretação IA de comandos)
OPENAI_API_KEY=sua_chave_openai_aqui
