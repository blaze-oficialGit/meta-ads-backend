# ============================================
# META ADS MVP - Variáveis de Ambiente
# ============================================
# COPIE este arquivo para ".env" e preencha com seus dados reais.
# No Railway, você cola essas variáveis no painel "Variables".

# Porta do servidor (o Railway define automaticamente, mas deixe 3000 para teste local)
PORT=3000

# Chave secreta para sessões (gere uma string aleatória qualquer, ex: "minha-chave-super-secreta-123")
SESSION_SECRET=cole-aqui-uma-string-aleatoria-grande

# --- CREDENCIAIS DO APP META (developers.facebook.com) ---
META_APP_ID=cole_aqui_seu_app_id
META_APP_SECRET=cole_aqui_seu_app_secret

# URL de retorno após login Meta (DEPOIS que o backend estiver no Railway, troque localhost pela URL do Railway)
# Exemplo final: https://meu-backend.up.railway.app/api/auth/callback
META_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Versão da API da Meta (use a mais recente estável)
META_API_VERSION=v21.0

# --- CHAVE DA OPENAI (para interpretar comandos em português) ---
# Pegue em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-cole-aqui-sua-chave-openai

# URL do FRONTEND (depois que hospedar no Vercel, coloque a URL do Vercel aqui)
# Exemplo final: https://meu-projeto.vercel.app
FRONTEND_URL=http://localhost:5173